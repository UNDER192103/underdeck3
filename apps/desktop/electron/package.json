{
  "name": "underdeck",
  "description": "UnderDeck Application",
  "productName": "Under Deck",
  "version": "4.3.3",
  "main": "dist/main/main.js",
  "type": "module",
  "author": "Under",
  "license": "MIT",
  "underdeck": {
    "github": {
      "owner": "UNDER192103",
      "repo": "underdeck3"
    }
  },
  "scripts": {
    "start": "pnpm run compile && set NODE_OPTIONS=--import tsx && electron src/main/main.ts",
    "nodemon": "nodemon --exitcrash --watch src --ext ts --exec \"cls && pnpm start\" --delay 2",
    "clean": "rimraf dist build",
    "compile": "tsc",
    "build:prepare": "pnpm run clean && pnpm --filter underdeck-desktop-client run build && pnpm run compile",
    "build:unpacked": "pnpm run build:prepare && dotenv -e .env -- electron-builder --dir",
    "build:velopack": "pnpm run build:prepare && dotenv -e .env -- ..\\..\\..\\scripts\\velopack.bat",
    "build:velopack:local": "pnpm run build:prepare && ..\\..\\..\\scripts\\velopack.bat local",
    "build:velopack:local:test": "pnpm run build:prepare && ..\\..\\..\\scripts\\velopack.bat local-test",
    "rebuild:native": "electron-rebuild -f -w robotjs,better-sqlite3",
    "postinstall": "electron-rebuild",
    "dist": "pnpm run build:velopack",
    "dist:publish": "pnpm run build:velopack",
    "dist:prod": "pnpm run build:velopack",
    "dist:local": "pnpm run build:velopack:local",
    "dist:local:test": "pnpm run build:velopack:local:test"
  },
  "dependencies": {
    "@ghostery/adblocker-electron": "^2.14.1",
    "@types/qrcode": "^1.5.6",
    "auto-launch": "^5.0.6",
    "axios": "^1.13.6",
    "better-sqlite3": "^13.0.3",
    "call-bind-apply-helpers": "^1.0.2",
    "cli-color": "^2.0.4",
    "cross-fetch": "^4.1.0",
    "decompress": "^4.2.1",
    "discord-rpc": "^4.0.1",
    "dotenv": "^17.3.1",
    "electron-cookies": "^1.1.0",
    "express": "^5.2.1",
    "googleapis": "^178.0.0",
    "obs-websocket-js": "^5.0.7",
    "open": "^11.0.0",
    "qrcode": "^1.5.4",
    "robotjs": "^0.9.1",
    "socket.io": "^4.8.3",
    "tiktok-live-connector": "^2.4.4",
    "tmi.js": "^1.8.5",
    "uiohook-napi": "^1.5.4",
    "velopack": "1.2.110-ge826545",
    "ws": "^8.19.0",
    "xml-js": "^1.6.11"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cli-color": "^2.0.6",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.0",
    "@types/ws": "^8.18.1",
    "dotenv-cli": "^11.0.0",
    "electron": "44.2.0",
    "electron-builder": "^26.8.1",
    "node-gyp": "^13.0.2",
    "nodemon": "^3.1.14",
    "prebuild-install": "^7.1.3",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsx": "4.23.13",
    "typescript": "^7.0.2"
  }
}
